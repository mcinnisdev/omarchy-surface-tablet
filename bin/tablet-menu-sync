#!/bin/bash
# Keep a copy of the Omarchy menu that works with the on-screen keyboard.
#
# The built-in menu covers the whole screen and holds exclusive keyboard focus,
# which hides the keyboard and stops touches from reaching it while you type to
# filter (Hyprland only hit-tests exclusive layers). The copy makes two changes:
#   - it respects the space the keyboard reserves, so it sits above it
#   - it asks for on-demand keyboard focus, which Hyprland still grants when the
#     menu opens, but which lets touches reach the keyboard
#
#   tablet-menu-sync          (re)build the copy from the current Omarchy menu
#   tablet-menu-sync remove   go back to the built-in menu
#
# Installed as an Omarchy post-update hook so menu updates keep coming through.
set -euo pipefail

source_dir="${OMARCHY_PATH:-/usr/share/omarchy}/shell/plugins/menu"
id="${USER:-$(id -un)}.menu"
plugins="$HOME/.config/omarchy/plugins"
target="$plugins/$id"
stage="$HOME/.config/omarchy/.$id.stage"

# wait_for <jq condition over the plugin list>: the shell can take a few
# seconds to settle after plugin files change.
wait_for() {
  for _ in $(seq 60); do
    omarchy-plugin-list --json 2>/dev/null | jq -e "$1" >/dev/null && return 0
    sleep 0.25
  done
  return 1
}

use_builtin() {
  omarchy-plugin-enable omarchy.menu >/dev/null 2>&1 || true
  wait_for 'any(.[]; .id == "omarchy.menu" and .enabled)'
}

# Each replaced line must appear exactly once, or Omarchy's menu has changed
# and the copy isn't built.
patch_menu() {
  python3 - "$1" <<'PY'
import sys

path = sys.argv[1]
src = open(path).read()
patches = [
    (
        "    exclusionMode: ExclusionMode.Ignore\n",
        "    exclusionMode: ExclusionMode.Normal // tablet: stay clear of the on-screen keyboard\n",
    ),
    (
        "    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive\n",
        "    // tablet: Hyprland focuses on-demand layers when they map, and unlike\n"
        "    // Exclusive this doesn't block touches to the on-screen keyboard.\n"
        "    WlrLayershell.keyboardFocus: WlrKeyboardFocus.OnDemand\n",
    ),
]
for old, new in patches:
    if src.count(old) != 1:
        sys.exit("tablet-menu-sync: Omarchy's Menu.qml changed (%s); leaving the menu as it is" % old.strip())
    src = src.replace(old, new)
open(path, "w").write(src)
PY
}

if [[ ${1:-} == remove ]]; then
  use_builtin
  rm -rf "$target"
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  echo "Using the built-in Omarchy menu"
  exit 0
fi

# Build the copy outside the plugins folder so the shell only sees it once.
rm -rf "$stage"
mkdir -p "$stage"
cp -aL "$source_dir/." "$stage/"
jq --arg id "$id" '
  .id = $id |
  .name = "My Omarchy menu" |
  (if (.barWidget | type) == "object" then .barWidget.displayName = "My Omarchy menu" else . end) |
  .omarchy = ((if (.omarchy | type) == "object" then .omarchy else {} end) + {clonedFrom: "omarchy.menu"})
' "$stage/manifest.json" >"$stage/manifest.json.tmp"
mv "$stage/manifest.json.tmp" "$stage/manifest.json"

if ! patch_menu "$stage/Menu.qml"; then
  rm -rf "$stage"
  exit 1
fi

# Swap the copy in while the built-in menu is active, so a menu always works.
use_builtin
rm -rf "$target"
mkdir -p "$plugins"
mv "$stage" "$target"

# The shell's file watcher can hold on to a copy it tried to load while the
# files were missing, so restart it to load the new copy cleanly.
omarchy-restart-shell >/dev/null 2>&1 || true
for _ in $(seq 40); do
  timeout 2 omarchy-shell shell rescanPlugins >/dev/null 2>&1 && break
  sleep 0.5
done
if ! wait_for "any(.[]; .id == \"$id\")"; then
  echo "tablet-menu-sync: the shell didn't pick up $id; keeping the built-in menu" >&2
  exit 1
fi

omarchy-plugin-enable "$id" >/dev/null 2>&1 || true
if ! wait_for "any(.[]; .id == \"$id\" and .enabled)"; then
  use_builtin
  echo "tablet-menu-sync: couldn't switch to $id; keeping the built-in menu" >&2
  exit 1
fi

echo "Using $id (Omarchy menu that works with the on-screen keyboard)"
